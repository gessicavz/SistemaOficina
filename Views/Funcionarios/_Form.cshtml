@model SistemaOficina.Models.Funcionario
@{ var hoje = DateTime.Today.ToString("yyyy-MM-dd"); }
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-3">
 <div class="col-md-8"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control"/><span asp-validation-for="Nome" class="text-danger"></span></div>
 <div class="col-md-4"><label asp-for="CPF" class="form-label"></label><input asp-for="CPF" class="form-control" placeholder="000.000.000-00"/><span asp-validation-for="CPF" class="text-danger"></span></div>
 <div class="col-md-6"><label asp-for="Cargo" class="form-label"></label><input asp-for="Cargo" class="form-control"/><span asp-validation-for="Cargo" class="text-danger"></span></div>
 <div class="col-md-6"><label asp-for="Telefone" class="form-label"></label><input asp-for="Telefone" class="form-control"/><span asp-validation-for="Telefone" class="text-danger"></span></div>
 <div class="col-md-6"><label asp-for="DataAdmissao" class="form-label"></label><input asp-for="DataAdmissao" class="form-control" max="@hoje"/><span asp-validation-for="DataAdmissao" class="text-danger"></span></div>
 <div class="col-md-6"><label asp-for="Salario" class="form-label"></label><input asp-for="Salario" class="form-control"/><span asp-validation-for="Salario" class="text-danger"></span></div>
 <div class="col-12 form-check ms-2"><input asp-for="Ativo" class="form-check-input"/><label asp-for="Ativo" class="form-check-label"></label></div>
</div>
