@model SistemaOficina.Models.Funcionario
@{ ViewData["Title"] = "Detalhes do funcionário"; }
<div class="content-card"><h1>@Model.Nome</h1><dl class="row details"><dt class="col-sm-3">CPF</dt><dd class="col-sm-9">@Model.CPF</dd><dt class="col-sm-3">Cargo</dt><dd class="col-sm-9">@Model.Cargo</dd><dt class="col-sm-3">Telefone</dt><dd class="col-sm-9">@Model.Telefone</dd><dt class="col-sm-3">Admissão</dt><dd class="col-sm-9">@Model.DataAdmissao.ToString("dd/MM/yyyy")</dd><dt class="col-sm-3">Salário</dt><dd class="col-sm-9">@Model.Salario.ToString("C")</dd><dt class="col-sm-3">Situação</dt><dd class="col-sm-9">@(Model.Ativo ? "Ativo" : "Inativo")</dd><dt class="col-sm-3">Pagamentos</dt><dd class="col-sm-9">@Model.Pagamentos.Count registrado(s)</dd><dt class="col-sm-3">Equipamentos</dt><dd class="col-sm-9">@Model.Equipamentos.Count sob responsabilidade</dd></dl><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a> <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a></div>
