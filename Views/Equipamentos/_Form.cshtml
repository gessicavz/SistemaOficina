@model SistemaOficina.Models.Equipamento
@{ var hoje = DateTime.Today.ToString("yyyy-MM-dd"); }
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-3">
 <div class="col-md-6"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control"/><span asp-validation-for="Nome" class="text-danger"></span></div>
 <div class="col-md-3"><label asp-for="Tipo" class="form-label"></label><select asp-for="Tipo" asp-items="ViewBag.Tipos" class="form-select"><option value="">Selecione</option></select><span asp-validation-for="Tipo" class="text-danger"></span></div>
 <div class="col-md-3"><label asp-for="NumeroSerie" class="form-label"></label><input asp-for="NumeroSerie" class="form-control"/><span asp-validation-for="NumeroSerie" class="text-danger"></span></div>
 <div class="col-md-4"><label asp-for="Fabricante" class="form-label"></label><input asp-for="Fabricante" class="form-control"/></div>
 <div class="col-md-8"><label asp-for="Localizacao" class="form-label"></label><input asp-for="Localizacao" class="form-control" placeholder="Indústria / setor"/><span asp-validation-for="Localizacao" class="text-danger"></span></div>
 <div class="col-md-4"><label asp-for="DataAquisicao" class="form-label"></label><input asp-for="DataAquisicao" class="form-control" max="@hoje"/><span asp-validation-for="DataAquisicao" class="text-danger"></span></div>
 <div class="col-md-4"><label asp-for="ValorAquisicao" class="form-label"></label><input asp-for="ValorAquisicao" class="form-control"/><span asp-validation-for="ValorAquisicao" class="text-danger"></span></div>
 <div class="col-md-4"><label asp-for="DataUltimaManutencao" class="form-label"></label><input asp-for="DataUltimaManutencao" class="form-control" max="@hoje"/><span asp-validation-for="DataUltimaManutencao" class="text-danger"></span></div>
 <div class="col-md-6"><label asp-for="FuncionarioId" class="form-label"></label><select asp-for="FuncionarioId" asp-items="ViewBag.FuncionarioId" class="form-select"><option value="">Selecione</option></select><span asp-validation-for="FuncionarioId" class="text-danger"></span></div>
 <div class="col-md-6"><label asp-for="Situacao" class="form-label"></label><select asp-for="Situacao" asp-items="ViewBag.Situacoes" class="form-select"></select></div>
</div>
