@model SistemaOficina.Models.Equipamento
@{ ViewData["Title"] = "Detalhes do equipamento"; }
<div class="content-card"><h1>@Model.Nome</h1><dl class="row details"><dt class="col-sm-3">Tipo</dt><dd class="col-sm-9">@Model.Tipo</dd><dt class="col-sm-3">Nº de série</dt><dd class="col-sm-9">@Model.NumeroSerie</dd><dt class="col-sm-3">Fabricante</dt><dd class="col-sm-9">@Model.Fabricante</dd><dt class="col-sm-3">Localização</dt><dd class="col-sm-9">@Model.Localizacao</dd><dt class="col-sm-3">Aquisição</dt><dd class="col-sm-9">@Model.DataAquisicao.ToString("dd/MM/yyyy")</dd><dt class="col-sm-3">Valor</dt><dd class="col-sm-9">@Model.ValorAquisicao.ToString("C")</dd><dt class="col-sm-3">Última manutenção</dt><dd class="col-sm-9">@(Model.DataUltimaManutencao?.ToString("dd/MM/yyyy") ?? "Nenhuma registrada")</dd><dt class="col-sm-3">Situação</dt><dd class="col-sm-9">@Model.Situacao.Texto()</dd><dt class="col-sm-3">Técnico responsável</dt><dd class="col-sm-9">@Model.Funcionario?.Nome</dd></dl>@if (User.IsInRole("Administrador")) { <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a> }<a class="btn btn-outline-secondary" asp-action="Index">Voltar</a></div>
