@model ErrorViewModel
@{ ViewData["Title"] = "Erro"; }
<div class="content-card"><h1 class="text-danger">Erro</h1><p>Ocorreu um erro ao processar a sua solicitação.</p>
@if (Model.ShowRequestId) { <p><strong>ID da requisição:</strong> <code>@Model.RequestId</code></p> }
<a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Voltar ao início</a></div>
