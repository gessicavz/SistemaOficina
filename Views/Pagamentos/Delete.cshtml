@model SistemaOficina.Models.Pagamento
@{ ViewData["Title"] = "Excluir pagamento"; }
<div class="content-card form-card"><h1>Excluir pagamento</h1><div class="alert alert-warning">Tem certeza de que deseja excluir o pagamento de <strong>@Model.Funcionario?.Nome</strong> (@Model.Competencia, @Model.Valor.ToString("C"))?</div><form asp-action="Delete"><input type="hidden" asp-for="Id"/><button class="btn btn-danger">Excluir</button> <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a></form></div>
