@model SistemaOficina.Models.Pagamento
@{ ViewData["Title"] = "Detalhes do pagamento"; }
<div class="content-card"><h1>Pagamento de @Model.Funcionario?.Nome</h1><dl class="row details"><dt class="col-sm-3">Competência</dt><dd class="col-sm-9">@Model.Competencia</dd><dt class="col-sm-3">Valor</dt><dd class="col-sm-9">@Model.Valor.ToString("C")</dd><dt class="col-sm-3">Vencimento</dt><dd class="col-sm-9">@Model.DataVencimento.ToString("dd/MM/yyyy")</dd><dt class="col-sm-3">Pagamento</dt><dd class="col-sm-9">@(Model.DataPagamento?.ToString("dd/MM/yyyy") ?? "Não realizado")</dd><dt class="col-sm-3">Situação</dt><dd class="col-sm-9">@Model.Situacao</dd><dt class="col-sm-3">Observações</dt><dd class="col-sm-9">@Model.Observacoes</dd></dl><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a> <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a></div>
