@model IEnumerable<SistemaOficina.Models.Pagamento>
@{ ViewData["Title"] = "Relatórios"; string situacao = ViewBag.Situacao; }
<div class="page-heading"><div><h1>Relatórios</h1><p>Filtre e imprima os pagamentos.</p></div><button onclick="window.print()" class="btn btn-primary">Imprimir relatório</button></div>
<form method="get" class="content-card filter-form"><div class="row g-3"><div class="col-md-4"><label>Funcionário</label><select name="funcionarioId" asp-items="ViewBag.Funcionarios" class="form-select"><option value="">Todos</option></select></div><div class="col-md-2"><label>Início</label><input type="date" name="inicio" class="form-control" value="@ViewBag.Inicio"/></div><div class="col-md-2"><label>Fim</label><input type="date" name="fim" class="form-control" value="@ViewBag.Fim"/></div><div class="col-md-2"><label>Situação</label><select name="situacao" class="form-select"><option value="">Todas</option><option selected="@(situacao == "Pendente")">Pendente</option><option selected="@(situacao == "Pago")">Pago</option><option selected="@(situacao == "Atrasado")">Atrasado</option></select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Filtrar</button></div></div></form>
<div class="report-summary">Total encontrado: <strong>@Model.Sum(p => p.Valor).ToString("C")</strong></div>
<div class="table-responsive"><table class="table"><thead><tr><th>Funcionário</th><th>Competência</th><th>Vencimento</th><th>Pagamento</th><th>Valor</th><th>Situação</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Funcionario?.Nome</td><td>@p.Competencia</td><td>@p.DataVencimento.ToString("dd/MM/yyyy")</td><td>@(p.DataPagamento?.ToString("dd/MM/yyyy") ?? "—")</td><td>@p.Valor.ToString("C")</td><td>@p.Situacao</td></tr>}</tbody></table></div>
